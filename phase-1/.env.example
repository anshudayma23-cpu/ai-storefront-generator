# AI Storefront Generator - Environment Configuration

# 1. Google Gemini API (Free tier from Google AI Studio, billing OFF)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# 2. Supabase Postgres (Free tier project)
SUPABASE_URL=https://your_project_id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# 3. Application URL (Default local development, updated to Vercel URL on deploy)
NEXT_PUBLIC_APP_URL=http://localhost:3000
